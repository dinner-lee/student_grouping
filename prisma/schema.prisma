generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  LEARNER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String
  passwordHash String
  role         Role     @default(LEARNER)
  email        String?  @unique // Google 로그인 연동용
  image        String? // 프로필 사진 URL (Google 로그인 시 자동 반영)
  createdAt    DateTime @default(now())

  topic                Topic?
  topicLikes           TopicLike[]
  keywordLikes         KeywordLike[]
  comments             Comment[]
  topicPicks           TopicPick[]
  researchGroupMembers ResearchGroupMember[]
}

model InviteCode {
  id        String   @id @default(cuid())
  code      String   @unique
  role      Role     @default(LEARNER)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// 서비스 전역 설정 (단일 행, id="main") — 관리자 화면에서 편집
model AppSettings {
  id      String  @id @default("main")
  logoUrl String? // 헤더·로그인 화면에 표시할 로고 이미지 URL (비우면 로고 없이 텍스트만 표시)
}

// ── 관심 연구 주제 카드 ─────────────────────────────────

model Topic {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  markdown  String   @default("")
  keywords  String[] @default([])
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  likes          TopicLike[]
  comments       Comment[]
  picks          TopicPick[]
  researchGroups ResearchGroup[]
}

model TopicLike {
  id      String @id @default(cuid())
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([topicId, userId])
}

model KeywordLike {
  id      String @id @default(cuid())
  keyword String
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([keyword, userId])
}

model Comment {
  id        String   @id @default(cuid())
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
}

// 학습자가 동료 주제에 매긴 관심 순위 (1~5)
model TopicPick {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  rank    Int

  @@unique([userId, topicId])
  @@unique([userId, rank])
}

// ── 자율연구 모둠 ─────────────────────────────────────

model ResearchGroupSet {
  id          String    @id @default(cuid())
  groupCount  Int
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  groups ResearchGroup[]
}

model ResearchGroup {
  id      String           @id @default(cuid())
  setId   String
  set     ResearchGroupSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  index   Int
  topicId String // 이 모둠의 앵커 연구 주제
  topic   Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)

  members ResearchGroupMember[]

  @@unique([setId, index])
}

model ResearchGroupMember {
  id      String        @id @default(cuid())
  groupId String
  group   ResearchGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rank    Int? // 배정된 주제에 대한 본인의 선호 순위 (null = 선호 목록에 없던 주제)

  @@unique([groupId, userId])
}
